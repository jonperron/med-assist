# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/

# ...but `lib/` above is a Python build artifact rule and matches at any depth,
# which silently swallows the frontend's own source directory. Next.js keeps
# shared modules in `app/lib/` by convention, and a contributor adding one there
# would lose the files with no error.
!frontend/app/lib/
!frontend/app/lib/**
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.log
.hypothesis/
.pytest_cache/
celerybeat-schedule
*.pid
*.pid.lock
venv/
.venv/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# package-lock.json # If you prefer to only commit yarn.lock or vice-versa. Defaulting to commit it.
# Frontend build output
frontend/build/

# IDE / OS specific
.vscode/
.idea/
*.DS_Store
Thumbs.db

# Dev
.env

# Model
models/

