# The build context is ./backend, and everything in it is sent to the Docker
# daemon and cached there - whether or not a COPY ever mentions it.
#
# training/ is the first entry for a reason: it holds the clinical corpus and a
# multi-gigabyte CUDA environment, neither of which belongs anywhere near an
# image build. .gitignore does not apply here.
training/

# The weights, ~420MB. They reach the image through the model build stage
# (see Dockerfile.model), not through this context. Left out of .dockerignore
# they would be uploaded to the daemon on every build of the application
# image and cached there, whether or not a COPY mentions them.
#
# Dockerfile.model needs the opposite rule and gets it from its own
# Dockerfile.model.dockerignore, which BuildKit prefers over this file.
models/

.venv/
tests/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.env
