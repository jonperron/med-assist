{
  "components": {
    "schemas": {
      "AnalysisResponse": {
        "description": "Result of a stateless analysis. Nothing behind this response is stored.",
        "properties": {
          "documents": {
            "description": "Every submitted document, in submission order: the entities found in it for a caller that needs more than the summary, and whether it could be read at all. A document with `read` false is not behind the summary - the batch is refused outright only when none of them could be read.",
            "items": {
              "$ref": "#/components/schemas/AnalyzedDocument"
            },
            "title": "Documents",
            "type": "array"
          },
          "mapping_info": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "Information about the label mapping used (language, dataset)",
            "title": "Mapping Info"
          },
          "retained": {
            "default": false,
            "description": "Always false: this endpoint never writes to storage",
            "title": "Retained",
            "type": "boolean"
          },
          "summary": {
            "$ref": "#/components/schemas/ClinicalSummary",
            "description": "The submitted documents merged into one readable patient summary. This is what the endpoint is for; the rest is detail behind it."
          }
        },
        "required": [
          "summary",
          "documents"
        ],
        "title": "AnalysisResponse",
        "type": "object"
      },
      "AnalyzedDocument": {
        "description": "One submitted document: its entities, and whether it was read at all.\n\nCallers that already read `documents[i]` as entities keep working - the\nentity categories are unchanged, and an unread document simply has none.\nThe document is identified by its position in the list, which is the\ncaller's own submission order, so no filename has to cross the boundary for\nthe caller to say which of its files was skipped.",
        "properties": {
          "anatomy": {
            "default": [],
            "description": "Anatomical structures",
            "items": {
              "$ref": "#/components/schemas/EntityDetail"
            },
            "title": "Anatomy",
            "type": "array"
          },
          "document_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The date this document carries, read from its head. Null when it carries none that could be established - a document with no date in its letterhead, or an unread one - which is common and not an error. It is the document's own date, not the file's timestamp and not a date mentioned inside the clinical text.",
            "title": "Document Date"
          },
          "examinations": {
            "default": [],
            "description": "Medical examinations",
            "items": {
              "$ref": "#/components/schemas/EntityDetail"
            },
            "title": "Examinations",
            "type": "array"
          },
          "measurements": {
            "default": [],
            "description": "Measurements and values",
            "items": {
              "$ref": "#/components/schemas/EntityDetail"
            },
            "title": "Measurements",
            "type": "array"
          },
          "other": {
            "default": [],
            "description": "Other medical entities",
            "items": {
              "$ref": "#/components/schemas/EntityDetail"
            },
            "title": "Other",
            "type": "array"
          },
          "pathologies": {
            "default": [],
            "description": "Diseases and conditions",
            "items": {
              "$ref": "#/components/schemas/EntityDetail"
            },
            "title": "Pathologies",
            "type": "array"
          },
          "patient_info": {
            "default": [],
            "description": "Patient demographic information",
            "items": {
              "$ref": "#/components/schemas/EntityDetail"
            },
            "title": "Patient Info",
            "type": "array"
          },
          "read": {
            "description": "False when no text could be read from this document. It is then not behind the summary, and its entity categories are empty.",
            "title": "Read",
            "type": "boolean"
          },
          "symptoms": {
            "default": [],
            "description": "Signs and symptoms",
            "items": {
              "$ref": "#/components/schemas/EntityDetail"
            },
            "title": "Symptoms",
            "type": "array"
          },
          "temporal": {
            "default": [],
            "description": "Temporal information",
            "items": {
              "$ref": "#/components/schemas/EntityDetail"
            },
            "title": "Temporal",
            "type": "array"
          },
          "treatments": {
            "default": [],
            "description": "Treatments and medications",
            "items": {
              "$ref": "#/components/schemas/EntityDetail"
            },
            "title": "Treatments",
            "type": "array"
          },
          "unreadable_reason": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/UnreadableReason"
              },
              {
                "type": "null"
              }
            ],
            "description": "Why the document could not be read. Null when it was read."
          }
        },
        "required": [
          "read",
          "unreadable_reason",
          "document_date"
        ],
        "title": "AnalyzedDocument",
        "type": "object"
      },
      "Body_analyze_api_analyze_post": {
        "properties": {
          "files": {
            "description": "The documents to summarise (PDF, DOCX, TXT). Several documents are taken to be about the same patient and merged into one summary.",
            "items": {
              "contentMediaType": "application/octet-stream",
              "type": "string"
            },
            "title": "Files",
            "type": "array"
          }
        },
        "required": [
          "files"
        ],
        "title": "Body_analyze_api_analyze_post",
        "type": "object"
      },
      "Body_upload_document_api_upload_document__post": {
        "properties": {
          "file": {
            "contentMediaType": "application/octet-stream",
            "description": "The file to upload (PDF, DOCX, TXT).",
            "title": "File",
            "type": "string"
          }
        },
        "required": [
          "file"
        ],
        "title": "Body_upload_document_api_upload_document__post",
        "type": "object"
      },
      "Body_upload_documents_api_upload_documents__post": {
        "properties": {
          "files": {
            "description": "List of medical documents to upload. Supported formats: PDF, DOCX, TXT. Maximum size: 10MB per file.",
            "items": {
              "contentMediaType": "application/octet-stream",
              "type": "string"
            },
            "title": "Files",
            "type": "array"
          }
        },
        "required": [
          "files"
        ],
        "title": "Body_upload_documents_api_upload_documents__post",
        "type": "object"
      },
      "ClinicalSummary": {
        "description": "A readable summary of one or more documents about the same patient.\n\nEverything here is assembled from what the NER model emitted. No wording is\ngenerated: each finding is a span the model marked, deduplicated across the\nsubmitted documents and placed under a fixed heading.",
        "properties": {
          "date_range": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DateRange"
              },
              {
                "type": "null"
              }
            ],
            "description": "The stretch of time the dated documents cover, for a caller placing the summary in time. Absent when no submitted document carries a date this could be sure of - which is common, and not an error. Only documents that were read can be dated: see `AnalysisResponse.documents[].document_date` for the date behind each end of the range."
          },
          "document_count": {
            "description": "How many documents were read to build this summary. Lower than the number submitted when a document could not be read: see `AnalysisResponse.documents[].read`.",
            "title": "Document Count",
            "type": "integer"
          },
          "empty": {
            "default": false,
            "description": "True when nothing clinical was found. The caller should say so rather than render an empty page.",
            "title": "Empty",
            "type": "boolean"
          },
          "patient": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The demographic line, e.g. 'Patient, 67 ans, homme.' Absent when the documents carry no demographic mention.",
            "title": "Patient"
          },
          "sections": {
            "default": [],
            "description": "Clinical sections, in reading order. Empty ones are omitted.",
            "items": {
              "$ref": "#/components/schemas/SummarySection"
            },
            "title": "Sections",
            "type": "array"
          }
        },
        "required": [
          "date_range",
          "document_count"
        ],
        "title": "ClinicalSummary",
        "type": "object"
      },
      "DateRange": {
        "description": "The stretch of time a batch of documents covers.",
        "properties": {
          "end": {
            "description": "The latest document date in the batch. Equal to `start` when only one document in the batch carries a date.",
            "format": "date",
            "title": "End",
            "type": "string"
          },
          "start": {
            "description": "The earliest document date in the batch",
            "format": "date",
            "title": "Start",
            "type": "string"
          }
        },
        "required": [
          "start",
          "end"
        ],
        "title": "DateRange",
        "type": "object"
      },
      "EntityDetail": {
        "description": "Detailed information about an extracted entity.",
        "properties": {
          "end": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "End position in the text. Absent when the document text was not retained, since an offset means nothing without the text.",
            "title": "End"
