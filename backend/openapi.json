{
  "components": {
    "schemas": {
      "AnalysisResponse": {
        "description": "Result of a stateless analysis. Nothing behind this response is stored.",
        "properties": {
          "extracted_entities": {
            "$ref": "#/components/schemas/ExtractedEntities",
            "description": "Medical entities found in the text with detailed information"
          },
          "mapping_info": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "Information about the label mapping used (language, dataset)",
            "title": "Mapping Info"
          },
          "pseudonymized": {
            "description": "Whether the masking pass ran. It reports that every identifier the model detected was replaced, not that no identifier remains: an identifier the model misses is an identifier that survives.",
            "title": "Pseudonymized",
            "type": "boolean"
          },
          "retained": {
            "default": false,
            "description": "Always false: this endpoint never writes to storage",
            "title": "Retained",
            "type": "boolean"
          },
          "text": {
            "description": "Text extracted from the submitted document, pseudonymised when requested. Returned to the caller and kept nowhere else.",
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text",
          "extracted_entities",
          "pseudonymized"
        ],
        "title": "AnalysisResponse",
        "type": "object"
      },
      "Body_analyze_api_analyze_post": {
        "properties": {
          "file": {
            "contentMediaType": "application/octet-stream",
            "description": "The file to analyze (PDF, DOCX, TXT).",
            "title": "File",
            "type": "string"
          },
          "pseudonymize": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "description": "Mask entities detected as patient information. Defaults to the deployment's PSEUDONYMIZE_ENTITIES setting.",
            "title": "Pseudonymize"
          }
        },
        "required": [
          "file"
        ],
        "title": "Body_analyze_api_analyze_post",
        "type": "object"
      },
      "Body_upload_document_api_upload_document__post": {
        "properties": {
          "file": {
            "contentMediaType": "application/octet-stream",
            "description": "The file to upload (PDF, DOCX, TXT).",
            "title": "File",
            "type": "string"
          },
          "pseudonymize": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "description": "Mask entities detected as patient information. Defaults to the deployment's PSEUDONYMIZE_ENTITIES setting.",
            "title": "Pseudonymize"
          }
        },
        "required": [
          "file"
        ],
        "title": "Body_upload_document_api_upload_document__post",
        "type": "object"
      },
      "Body_upload_documents_api_upload_documents__post": {
        "properties": {
          "files": {
            "description": "List of medical documents to upload. Supported formats: PDF, DOCX, TXT. Maximum size: 10MB per file.",
            "items": {
              "contentMediaType": "application/octet-stream",
              "type": "string"
            },
            "title": "Files",
            "type": "array"
          },
          "pseudonymize": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "description": "Mask entities detected as patient information. Defaults to the deployment's PSEUDONYMIZE_ENTITIES setting.",
            "title": "Pseudonymize"
          }
        },
        "required": [
          "files"
        ],
        "title": "Body_upload_documents_api_upload_documents__post",
        "type": "object"
      },
      "EntityDetail": {
        "description": "Detailed information about an extracted entity.",
        "properties": {
          "end": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "End position in the text. Absent when the document text was not retained, since an offset means nothing without the text.",
            "title": "End"
          },
          "label": {
            "description": "The entity label/type from the NER model",
            "title": "Label",
            "type": "string"
          },
          "score": {
            "description": "Confidence score (0-1)",
            "title": "Score",
            "type": "number"
          },
          "start": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Start position in the text. Absent when the document text was not retained, since an offset means nothing without the text.",
            "title": "Start"
          },
          "text": {
            "description": "The extracted entity text",
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text",
          "label",
          "score"
        ],
        "title": "EntityDetail",
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": true,
        "description": "The body of a refusal.\n\nRoutes raise HTTPException with a fixed message, and add context only when\nthe context is about the request rather than the document: the allowed file\ntypes, a size limit, a batch cap. Nothing here quotes document content.",
        "properties": {
          "message": {
            "description": "Content-free description of the failure",
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "How every refusal reaches the client.\n\nFastAPI wraps a raised HTTPException as {\"detail\": ...}, so this is the\nshape the frontend actually parses. Documenting the inner payload alone\ndescribed a body the API never sends.",
        "properties": {
          "detail": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "ExtractedEntities": {
        "description": "All extracted medical entities grouped by category.",
        "properties": {
          "anatomy": {
            "default": [],
            "description": "Anatomical structures",
            "items": {
              "$ref": "#/components/schemas/EntityDetail"
            },
            "title": "Anatomy",
            "type": "array"
          },
          "examinations": {
            "default": [],
            "description": "Medical examinations",
            "items": {
              "$ref": "#/components/schemas/EntityDetail"
            },
            "title": "Examinations",
            "type": "array"
          },
          "measurements": {
            "default": [],
            "description": "Measurements and values",
            "items": {
              "$ref": "#/components/schemas/EntityDetail"
            },
            "title": "Measurements",
            "type": "array"
          },
          "other": {
            "default": [],
            "description": "Other medical entities",
            "items": {
              "$ref": "#/components/schemas/EntityDetail"
            },
            "title": "Other",
            "type": "array"
          },
          "pathologies": {
            "default": [],
            "description": "Diseases and conditions",
            "items": {
              "$ref": "#/components/schemas/EntityDetail"
            },
            "title": "Pathologies",
            "type": "array"
          },
          "patient_info": {
            "default": [],
            "description": "Patient demographic information",
            "items": {
              "$ref": "#/components/schemas/EntityDetail"
            },
            "title": "Patient Info",
            "type": "array"
          },
          "symptoms": {
            "default": [],
            "description": "Signs and symptoms",
            "items": {
              "$ref": "#/components/schemas/EntityDetail"
            },
            "title": "Symptoms",
            "type": "array"
          },
          "temporal": {
            "default": [],
            "description": "Temporal information",
            "items": {
              "$ref": "#/components/schemas/EntityDetail"
            },
            "title": "Temporal",
            "type": "array"
          },
          "treatments": {
            "default": [],
            "description": "Treatments and medications",
            "items": {
              "$ref": "#/components/schemas/EntityDetail"
            },
            "title": "Treatments",
            "type": "array"
          }
        },
        "title": "ExtractedEntities",
        "type": "object"
      },
      "ExtractionResponse": {
        "properties": {
          "expires_in_seconds": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Seconds before the stored document is automatically deleted",
            "title": "Expires In Seconds"
          },
          "extracted_entities": {
            "$ref": "#/components/schemas/ExtractedEntities",
            "description": "Medical entities found in the text with detailed information"
          },
          "file_id": {
            "description": "Unique identifier of the processed file",
            "title": "File Id",
            "type": "string"
          },
          "mapping_info": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "Information about the label mapping used (language, dataset)",
            "title": "Mapping Info"
          },
          "processed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "When the extraction was completed",
            "title": "Processed At"
          },
          "text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Extracted text from the document. Null unless the deployment opted into storing document text.",
            "title": "Text"
          }
        },
        "required": [
          "file_id",
          "extracted_entities"
        ],
        "title": "ExtractionResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "MultipleUploadResponse": {
        "properties": {
          "batch_id": {
            "description": "Identifier correlating the files of one upload request. Nothing is stored under it: the batch cannot be resolved server-side, only the file IDs can.",
            "title": "Batch Id",
            "type": "string"
          },
          "file_ids": {
            "description": "List of file IDs in the batch",
            "items": {
              "type": "string"
            },
            "title": "File Ids",
            "type": "array"
          },
          "message": {
            "description": "Batch upload status message",
            "title": "Message",
            "type": "string"
          },
          "total_files": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Total number of files processed",
            "title": "Total Files"
          },
          "uploaded_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Upload timestamp",
            "title": "Uploaded At"
          }
        },
        "required": [
          "batch_id",
          "file_ids",
          "message"
        ],
        "title": "MultipleUploadResponse",
        "type": "object"
      },
      "UploadResponse": {
        "properties": {
          "content_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "MIME type of the file",
            "title": "Content Type"
          },
          "expires_in_seconds": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Seconds before the stored document is automatically deleted",
            "title": "Expires In Seconds"
          },
          "file_id": {
            "description": "Unique identifier of the uploaded file",
            "title": "File Id",
            "type": "string"
          },
          "filename": {
            "description": "Original filename",
            "title": "Filename",
            "type": "string"
          },
          "message": {
            "description": "Upload status message",
            "title": "Message",
            "type": "string"
          },
          "size": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "File size in bytes",
            "title": "Size"
          },
          "uploaded_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Upload timestamp",
            "title": "Uploaded At"
          }
        },
        "required": [
          "file_id",
          "filename",
          "message"
        ],
        "title": "UploadResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Med-Assist Backend",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/": {
      "get": {
        "operationId": "root__get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Root"
      }
    },
    "/api/analyze": {
      "post": {
        "description": "Analyze a medical document in a single request, storing nothing.\n\nThe document is read, analysed and answered in memory. No file id is issued\nbecause there is nothing to come back for, and nothing to delete later.\n\nArgs:\n    file: The uploaded file (PDF, DOCX, TXT)\n    pseudonymize: Whether to mask detected patient identifiers\n\nReturns:\n    AnalysisResponse: The extracted text and its medical entities\n\nRaises:\n    HTTPException: 400 for an invalid or unreadable file, 500 for server errors",
        "operationId": "analyze_api_analyze_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_analyze_api_analyze_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid or unreadable document"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "File too large"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal server error"
          }
        },
        "summary": "Analyze",
        "tags": [
          "Stateless Analysis"
        ]
      }
    },
    "/api/documents/{file_id}": {
      "delete": {
        "description": "Delete a stored document before its retention window expires.\n\nArgs:\n    file_id: The unique identifier of the document to delete\n    text_repository: Injected text repository dependency\n\nRaises:\n    HTTPException: 400 for a malformed file ID, 404 if nothing was stored",
        "operationId": "delete_document_api_documents__file_id__delete",
        "parameters": [
          {
            "description": "Unique identifier of the document to delete",
            "in": "path",
            "name": "file_id",
            "required": true,
            "schema": {
              "description": "Unique identifier of the document to delete",
              "examples": [
                "123e4567-e89b-12d3-a456-426614174000"
              ],
              "title": "File Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Document deleted"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid file ID format"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Document not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete Document",
        "tags": [
          "Document Uploads"
        ]
      }
    },
    "/api/get_extracted_text/{file_id}": {
      "get": {
        "description": "Endpoint to retrieve the entities extracted from a processed file.\n\nEntities are extracted at upload time, so this only reads what was stored.\nThe document text comes back only when the deployment kept it.\n\nArgs:\n    file_id: The unique identifier of the file to read\n    text_repository: Injected text repository dependency\n    entity_extractor: Injected entity extractor dependency\n\nReturns:\n    ExtractionResponse: Contains the file ID, identified medical entities and,\n    when retained, the extracted text\n\nRaises:\n    HTTPException: 404 if file not found or not processed yet",
        "operationId": "get_extracted_text_api_get_extracted_text__file_id__get",
        "parameters": [
          {
            "description": "Unique identifier of the uploaded file to extract text and entities from",
            "example": "123e4567-e89b-12d3-a456-426614174000",
            "in": "path",
            "name": "file_id",
            "required": true,
            "schema": {
              "description": "Unique identifier of the uploaded file to extract text and entities from",
              "title": "File Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtractionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid file ID format"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "File not found or not processed yet"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Extracted Text",
        "tags": [
          "Text Extractions"
        ]
      }
    },
    "/api/upload_document/": {
      "post": {
        "description": "Upload a medical document for text extraction and entity recognition.\n\nArgs:\n    file: The uploaded file (PDF, DOCX, TXT)\n    pseudonymize: Whether to mask detected patient identifiers\n\nReturns:\n    UploadResponse: Contains file ID, filename, and upload confirmation\n\nRaises:\n    HTTPException: 400 for invalid file type, 500 for server errors",
        "operationId": "upload_document_api_upload_document__post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_document_api_upload_document__post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid file type or format"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "File too large"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal server error"
          }
        },
        "summary": "Upload Document",
        "tags": [
          "Document Uploads"
        ]
      }
    },
    "/api/upload_documents/": {
      "post": {
        "description": "Upload multiple medical documents for text extraction and entity recognition.\n\nEach file is processed on its own and answered with its own id. The batch id\nonly correlates the files of this request: nothing is written under it, so\nthere is one less patient-adjacent key living out a retention window.\n\nArgs:\n    files: The uploaded files (PDF, DOCX, TXT)\n    pseudonymize: Whether to mask detected patient identifiers\n\nReturns:\n    MultipleUploadResponse: Contains batch id with associated file ids\n\nRaises:\n    HTTPException: 400 for invalid file type, 500 for server errors",
        "operationId": "upload_documents_api_upload_documents__post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_documents_api_upload_documents__post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MultipleUploadResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid file type or format"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "A file is too large, or the batch holds too many files"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal server error"
          }
        },
        "summary": "Upload Documents",
        "tags": [
          "Document Uploads"
        ]
      }
    },
    "/healthz": {
      "get": {
        "description": "Health check endpoint to verify if the API is running.",
        "operationId": "health_check_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health Check",
        "tags": [
          "Health Check"
        ]
      }
    }
  }
}
