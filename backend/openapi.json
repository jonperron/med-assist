  "paths": {
    "/": {
      "get": {
        "operationId": "root__get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Root"
      }
    },
    "/api/analyze": {
      "post": {
        "description": "Summarise one or more medical documents in a single request, storing nothing.\n\nThe documents are read, analysed and answered in memory. No file id is\nissued because there is nothing to come back for, and nothing to delete\nlater. The document text is not echoed back: the summary is the product,\nand returning the text would widen what leaves the server for no gain.\n\nA batch holding one document that cannot be read still answers 200, with\nthat document marked unread and the summary built from the rest. Only a\nbatch where nothing could be read is refused.\n\nArgs:\n    files: The uploaded documents (PDF, DOCX, TXT)\n\nReturns:\n    AnalysisResponse: The merged summary and the entities behind it\n\nRaises:\n    HTTPException: 400 for an invalid file or a batch nothing could be read\n        from, 413 for a file or batch that is too large, 500 for server\n        errors",
        "operationId": "analyze_api_analyze_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_analyze_api_analyze_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
