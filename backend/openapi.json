            "description": "File extensions this endpoint accepts",
            "title": "Allowed Extensions"
          },
          "allowed_types": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "File types this endpoint accepts",
            "title": "Allowed Types"
          },
          "max_files": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Largest accepted number of files in one batch",
            "title": "Max Files"
          },
          "max_size_bytes": {
            "anyOf": [
              {
                "type": "integer"
              },
