                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Start position in the text. Absent when the document text was not retained, since an offset means nothing without the text.",
            "title": "Start"
          },
          "text": {
            "description": "The extracted entity text",
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text",
          "label",
          "score"
        ],
        "title": "EntityDetail",
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "description": "The body of a refusal.\n\nRoutes raise HTTPException with a fixed message, and add context only when\nthe context is about the request rather than the document: the allowed file\ntypes, a size limit, a batch cap. Nothing here quotes document content.",
