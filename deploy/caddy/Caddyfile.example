# An authenticating reverse proxy in front of Med-Assist.
#
# Copy to Caddyfile, replace every placeholder, and read deploy/README.md for
# what this does and does not protect. Nothing in this file is a credential:
# the password is a hash you generate, and the backend's shared credential is
# read from the environment and never written here.
#
# The shape is one domain, not two. That is what makes the shipped browser
# interface work behind authentication: the page and the API are the same
# origin, so a browser that has authenticated to the domain sends its
# credentials on the interface's own calls to /api and /readyz. Two domains
# would prompt on the page and then fail every fetch, because a browser does
# not volunteer credentials on a cross-origin request.
#
# Two things this file cannot do for you, and both fail confusingly:
#
# 1. `backend:8000` and `frontend:3000` are Docker service names. They resolve
#    only if Caddy runs on the same Compose network - as a service in
#    docker-compose.yml, or an external container attached to that network.
#    Otherwise every request fails DNS resolution.
# 2. `{env.API_ACCESS_TOKEN}` is read from CADDY's environment, not the
#    backend's. The application's .env reaches the backend container; it does
#    not reach a proxy that Compose does not start. If the variable is missing
#    here, every request arrives at the backend as a bare `Bearer ` and is
#    refused - a blanket 401 that looks like a wrong token rather than an
#    absent one. It fails closed, but it fails opaquely.
#
# Set alongside it, in the application's .env:
#   NEXT_PUBLIC_API_URL=https://med-assist.example.org   (needs a frontend rebuild)
#   CORS_ALLOWED_ORIGINS=https://med-assist.example.org
#   API_ACCESS_TOKEN=<generated, see .env.example>
# and the same API_ACCESS_TOKEN in the proxy's own environment.

med-assist.example.org {
	# Authenticates the person. This is the control that actually keeps
	# strangers out; everything below is depth behind it.
	#
	# Generate the hash with `caddy hash-password` and paste the result - it is
	# a bcrypt hash, not a password, and it is still not something to commit.
	# On Caddy older than 2.8 the directive is spelled `basicauth`.
	#
	# Basic auth is the smallest thing that works and is a fair way short of
	# the best. It has no lockout, no second factor and no session, and every
	# request carries the password. For anything beyond a handful of known
	# people, replace this block with `forward_auth` to an identity provider;
	# the rest of the file is unchanged.
	basic_auth {
		clinician REPLACE_WITH_THE_OUTPUT_OF_caddy_hash-password
	}

	# The paths the backend answers: the analysis routes, and the two health
	# endpoints the interface polls. Everything else is the frontend.
	@backend path /api/* /healthz /readyz

	handle @backend {
		reverse_proxy backend:8000 {
			# Replaces the browser's Basic credentials with the backend's own,
			# so the person's password never reaches the application and the
			# application still refuses anything that did not come through
			# here. Read from the proxy's environment - do not inline a value.
			header_up Authorization "Bearer {env.API_ACCESS_TOKEN}"

			# Authorization is the ONLY request header replaced here, and that
			# is deliberate. The backend also refuses a request whose `Origin`
			# is not one it serves, which is what stops another site driving an
			# upload through a logged-in clinician's browser - your cached Basic
			# credentials are ambient and would otherwise authenticate the
			# forgery. That check reads `Origin` and the `Sec-Fetch-*` headers
			# exactly as the browser wrote them.
			#
			# So do not add `header_up -Origin`, `header_up Origin ...`, or a
			# WAF rule that normalises either. Stripping `Origin` does not
			# tighten anything: the backend treats an absent one as a
			# server-side call and lets it through, so the CSRF control turns
			# off with nothing in any log to say it did.

			# POST /api/analyze/stream answers Server-Sent Events. Without
			# this, Caddy buffers them and the progress the clinician is
			# watching arrives in one lump at the end, which is the whole
			# feature gone.
			flush_interval -1

			# No timeout is configured on purpose. Caddy 2 sets no default
			# ceiling on how long a response body may take, and an SSE response
			# commits its headers immediately, so a batch that takes tens of
			# seconds on a CPU is not at risk from one. `response_header_timeout`
			# would bound only the wait for the first byte, which is not the
			# slow part here. `read_timeout` is a fastcgi subdirective and is
			# rejected by the http transport at config-adapt time - a copied
			# file carrying it does not start at all.
		}
	}

	handle {
		reverse_proxy frontend:3000
	}

	# Uploaded documents are patient data in flight. Caddy obtains and renews
	# the certificate itself; there is no HTTP listener to fall back to.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	# The access log records the request line, the status, the client IP and
	# the request headers - not just paths. `Authorization` and `Cookie` are
	# redacted because `log_credentials` defaults to off: never turn it on, or
	# this file collects the clinician's password and the backend's credential
	# in plaintext, on disk, unrotated.
	#
	# No route here mints or accepts an identifier for a document, so a path
	# names nothing - keep it that way if you ever add a query parameter. The
	# client IP is recorded, which makes this a log of who used a clinical tool
	# and when; how long it is kept is your decision to make, not one this file
	# makes for you.
	log {
		output file /var/log/caddy/med-assist.log
	}
}
